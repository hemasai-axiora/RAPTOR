{
    "commands": [
        "cp /etc/letsencrypt/live/raptor-0001/fullchain.pem /etc/letsencrypt/live/raptor/fullchain.pem",
        "cp /etc/letsencrypt/live/raptor-0001/privkey.pem /etc/letsencrypt/live/raptor/privkey.pem",
        "chmod 644 /etc/letsencrypt/live/raptor/fullchain.pem",
        "chmod 600 /etc/letsencrypt/live/raptor/privkey.pem",
        "docker restart raptor-nginx"
    ]
}
